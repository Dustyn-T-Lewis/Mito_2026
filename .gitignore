# macOS
.DS_Store

# Office lock files
~$*

# R session state / IDE
.Rhistory
.RData
.Rdata
*.RData
.Rproj.user/
.Renviron
.httr-oauth
Rplots.pdf

# R package build artifacts
*.tar.gz
*.Rcheck/

# Root-level duplicates of 00_input/ files (canonical copies live in 00_input/)
/DAP_lists.xlsx
/Proteomics of PE with mito transfer*.xlsx

# Operational working notes (not project documentation)
/*_PROMPT.md

# Writeup / documentation deliverables (live locally; README.md is the only
# tracked doc for repo orientation)
**/*.docx
**/*.pdf
**/*.pptx
**/RESULTS_INTERPRETATION.*
**/METHODS*.md
**/MANUSCRIPT*.md
**/AUDIT*.md
**/NOTES*.md

# but the stage outputs are tracked, minus PDF and xlsx: both restamp an internal
# clock every run, so git stores a fresh copy even when no number changed. The plots
# survive as PNG and the tables as CSV.
!**/b_reports/**
!**/c_data/**
**/b_reports/**/*.pdf
**/c_data/**/*.pdf
**/b_reports/**/*.xlsx
**/c_data/**/*.xlsx

# proteoDA writes these two as PDF and refuses any other extension. They are 2.6 MB
# and stage 02 is re-run about once a project, so the churn the rule guards against
# does not apply.
!02_Normalization/b_reports/norm_comparison.pdf
!02_Normalization/b_reports/qc_normalized.pdf

# rendered quarto docs (source .qmd is tracked, .html is regenerated)
Mito_pipeline.html
tutorials/*.html
*_cache/

# Process scratch — briefs, audits, checksums; deletable at project completion
docs/
**/*manuscript*.md

# Rendered supplementary bundle — regenerate from the stage outputs
/Supplementary/
/Supplementary.zip

# python
__pycache__/
*.pyc
