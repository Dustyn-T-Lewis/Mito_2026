# macOS
.DS_Store

# Office lock files
~$*

# R session state / IDE
.Rhistory
.RData
.Rdata
*.RData
.Rproj.user/
.Renviron
.httr-oauth
Rplots.pdf

# R package build artifacts
*.tar.gz
*.Rcheck/

# Root-level duplicates of 00_input/ files (canonical copies live in 00_input/)
/DAP_lists.xlsx
/Proteomics of PE with mito transfer*.xlsx

# Operational working notes (not project documentation)
/*_PROMPT.md

# Writeup / documentation deliverables (live locally; README.md is the only
# tracked doc for repo orientation)
**/*.docx
**/*.pdf
**/*.pptx
**/RESULTS_INTERPRETATION.*
**/METHODS*.md
**/MANUSCRIPT*.md
**/AUDIT*.md
**/NOTES*.md

# Stage outputs are tracked. Two exclusions, each a duplicate of something already
# here: the 03_DEP contrast plots, written as PDF and PNG side by side, and
# results.xlsx, whose sheets are the tracked combined_results_pi.csv at 14 MB a copy.
!**/b_reports/**
!**/c_data/**
03_DEP/**/static_plots/*.pdf
03_DEP/**/results.xlsx

# Single-page S Figure PDFs are intermediates; the combined S<n>_Figure.pdf is tracked.
04_Figures/*/b_reports/supp/*.pdf

# The packaged supplementary material the manuscript cites.
!Supplementary_Material/**

# rendered quarto docs (source .qmd is tracked, .html is regenerated)
Mito_pipeline.html
tutorials/*.html
*_cache/

# Process scratch — briefs, audits, checksums; deletable at project completion
docs/
**/*manuscript*.md

# Rendered supplementary bundle — regenerate from the stage outputs
/Supplementary/
/Supplementary.zip

# python
__pycache__/
*.pyc
